<group name="local,sysmon,">

  <rule id="100010" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)PSScriptPolicyTest</field>
    <description>Falso positivo: archivo temporal propio de PowerShell (PSScriptPolicyTest), no es malware</description>
  </rule>

  <rule id="100011" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)csc\.exe$</field>
    <description>Falso positivo: artefactos de compilacion en memoria de C# (csc.exe) generados por PowerShell/Add-Type, comportamiento normal</description>
  </rule>

  <rule id="100020" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(e|enc|encodedcommand)\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Ejecucion de PowerShell con comando codificado en Base64 (cualquier proceso padre)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100030" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(pcwutl\.dll,LaunchApplication|advpack\.dll,LaunchINFSection|ieadvpack\.dll,LaunchINFSection|syssetup\.dll,SetupInfObjectInstallAction|setupapi\.dll,InstallHinfSection|url\.dll,OpenURL|url\.dll,FileProtocolHandler)</field>
    <description>Rundll32 ejecutando una funcion conocida de proxy execution (LOLBin)</description>
    <mitre><id>T1218.011</id></mitre>
  </rule>

  <rule id="100040" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)regsvr32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/i:.*scrobj\.dll</field>
    <description>Regsvr32 ejecutando un scriptlet (.sct) via scrobj.dll - patron Squiblydoo</description>
    <mitre><id>T1218.010</id></mitre>
  </rule>

  <rule id="100050" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create.*(cmd\.exe|powershell\.exe|wscript|cscript|mshta|rundll32|regsvr32)</field>
    <description>Creacion de tarea programada que ejecuta un interprete de comandos o LOLBin</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <rule id="100060" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^gup\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)^(?!.*notepad).*gup\.exe$</field>
    <description>GUP.exe ejecutandose fuera de su carpeta esperada - indicio de DLL Side-Loading</description>
    <mitre><id>T1574.001</id></mitre>
  </rule>

  <rule id="100070" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)cmd\.exe$</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)ADMIN\$.{0,5}__\d{8}</field>
    <description>Patron de Impacket wmiexec.py: cmd.exe redirigiendo salida a ADMIN$__(timestamp)</description>
    <mitre><id>T1047</id></mitre>
  </rule>

  <rule id="100080" level="0">
    <if_sid>61640</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)svchost\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/factory,\{.*\}\s*-Embedding</field>
    <description>Falso positivo: lanzamiento legitimo de explorer.exe como servidor COM (DCOM)</description>
  </rule>

  <rule id="100090" level="12">
    <if_sid>92005</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)bitsadmin\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/transfer.*(/download|/upload)</field>
    <description>Uso de BITSAdmin para transferencia de archivos - posible descarga de payload</description>
    <mitre><id>T1197</id></mitre>
    <group>bitsadmin,lolbin,local</group>
  </rule>

  <rule id="100100" level="12">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs\.dll.*MiniDump</field>
    <description>Posible volcado de memoria via rundll32 + comsvcs.dll - no validada por bloqueo de Defender</description>
    <mitre><id>T1003.001</id></mitre>
    <group>lsass,credential-access,local</group>
  </rule>

  <rule id="100110" level="14">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)downloadstring.*mimikatz</field>
    <description>Posible descarga y ejecucion de Mimikatz via PowerShell - no validada por bloqueo de Defender</description>
    <mitre><id>T1003</id></mitre>
    <group>mimikatz,credential-access,local</group>
  </rule>

  <!-- T1486 - Data Encrypted for Impact (Ransomware Simulation) -->

  <rule id="100200" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">\.locked$</field>
    <description>T1486 - Ransomware: archivo cifrado creado (.locked) por python.exe</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware,t1486,sysmon_eid11,windows</group>
  </rule>

  <rule id="100210" level="12">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^23$</field>
    <field name="win.eventdata.image" type="pcre2">python\.exe$</field>
    <description>T1486 - Ransomware: archivo original eliminado tras cifrado por python.exe</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware,t1486,sysmon_eid23,windows</group>
  </rule>

</group>
